{
  "name": "app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @app-template/api --filter @app-template/web dev",
    "dev:api": "pnpm --filter @app-template/api dev",
    "dev:web": "pnpm --filter @app-template/web dev",
    "preview:web": "pnpm --filter @app-template/web preview",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "pnpm --recursive --if-present lint",
    "lint:fix": "pnpm --recursive --if-present lint:fix",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --recursive --if-present test:coverage",
    "test:e2e": "cross-env TMPDIR=/tmp TEMP=/tmp TMP=/tmp playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:e2e",
    "ci": "pnpm check",
    "fix": "pnpm format && pnpm lint:fix",
    "clean": "rimraf coverage test-results playwright-report apps/*/dist apps/*/coverage apps/*/test-results apps/*/playwright-report",
    "agent:quick": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "agent:verify": "pnpm check",
    "agent:review": "pnpm agent:quick && pnpm build && pnpm test:e2e",
    "agent:status": "git status --short --branch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9"
  }
}
