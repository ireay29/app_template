{
  "name": "app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm db:seed && pnpm dev:servers",
    "dev:compose": "pnpm dev",
    "dev:supabase": "sh ./scripts/supabase-dev.sh",
    "dev:vercel": "sh ./scripts/vercel-dev.sh",
    "dev:servers": "pnpm --parallel --filter @app-template/api --filter @app-template/web dev",
    "dev:api": "pnpm --filter @app-template/api dev",
    "dev:web": "pnpm --filter @app-template/web dev",
    "prepare": "husky",
    "preview:web": "pnpm --filter @app-template/web preview",
    "db:up": "sh ./scripts/compose.sh up -d postgres",
    "db:down": "sh ./scripts/compose.sh down",
    "db:wait": "pnpm --filter @app-template/api db:wait",
    "db:generate": "pnpm --filter @app-template/api db:generate",
    "db:migrate": "pnpm --filter @app-template/api db:migrate",
    "db:seed": "pnpm --filter @app-template/api db:seed",
    "db:studio": "pnpm --filter @app-template/api db:studio",
    "db:reset": "sh ./scripts/compose.sh down -v && pnpm db:up && pnpm db:wait && pnpm db:migrate",
    "supabase:start": "pnpm exec supabase start",
    "supabase:stop": "pnpm exec supabase stop",
    "supabase:status": "pnpm exec supabase status",
    "openapi:schema": "pnpm --filter @app-template/api openapi:schema",
    "openapi:generate": "mkdir -p apps/web/src/generated && pnpm openapi:schema > /tmp/app-template-openapi.json && openapi-typescript /tmp/app-template-openapi.json -o apps/web/src/generated/openapi.ts && prettier --write apps/web/src/generated/openapi.ts",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- apps/web/src/generated/openapi.ts",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --workspace-concurrency=1 --recursive --if-present test",
    "test:coverage": "pnpm --workspace-concurrency=1 --recursive --if-present test:coverage",
    "test:ui": "pnpm test:ui:web",
    "test:ui:api": "pnpm --filter @app-template/api test:ui",
    "test:ui:web": "pnpm --filter @app-template/web test:ui",
    "test:e2e": "cross-env TMPDIR=/tmp TEMP=/tmp TMP=/tmp playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm openapi:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm deploy:check && pnpm test:e2e",
    "ci": "pnpm check",
    "deploy:check": "sh ./scripts/deploy-check.sh",
    "container:smoke": "sh ./scripts/container-smoke.sh",
    "supabase:verify": "sh ./scripts/supabase-verify.sh",
    "vercel:entrypoint:check": "tsc -p tsconfig.vercel.json --noEmit",
    "vercel:check": "sh ./scripts/vercel-check.sh",
    "fix": "pnpm format && pnpm lint:fix",
    "clean": "rimraf coverage test-results playwright-report apps/*/dist apps/*/coverage apps/*/test-results apps/*/playwright-report",
    "agent:quick": "pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "agent:verify": "pnpm db:up && pnpm db:wait && pnpm db:migrate && pnpm check",
    "agent:review": "pnpm agent:quick && pnpm build && pnpm test:e2e",
    "agent:status": "git status --short --branch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rimraf": "^6.1.3",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vercel": "^54.21.1",
    "vitest": "^4.1.10"
  }
}
