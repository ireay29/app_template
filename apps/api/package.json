{
  "name": "@app-template/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env TMPDIR=/tmp TEMP=/tmp TMP=/tmp tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run",
    "test:coverage": "cross-env TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run --coverage",
    "test:watch": "cross-env TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  }
}
