# Copy this file to .env for local development.
# Do not commit real production secrets.

DATABASE_URL=postgres://app_template:app_template@localhost:15432/app_template
# Optional migration/direct URL. Drizzle Kit uses this when set.
# DATABASE_MIGRATION_URL=postgres://app_template:app_template@localhost:15432/app_template
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=8787

# Optional Supabase local overrides.
# Supabase local Postgres defaults to:
# SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# SUPABASE_DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional Vercel local override.
# VERCEL_DEV_LISTEN=3000

# Optional Docker Compose PostgreSQL overrides.
# Keep DATABASE_URL in sync if these are changed.
# POSTGRES_PORT=15432
# POSTGRES_DB=app_template
# POSTGRES_USER=app_template
# POSTGRES_PASSWORD=app_template

# Optional local seed users.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=password1234
# SEED_ADMIN_NAME=Admin User
# SEED_MEMBER_EMAIL=member@example.com
# SEED_MEMBER_PASSWORD=password1234
# SEED_MEMBER_NAME=Member User

# Optional placeholders for future external IdP integrations.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
