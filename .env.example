# Copy this file to .env for local development.
# Do not commit real production secrets.

DATABASE_URL=postgres://app_template:app_template@localhost:15432/app_template
BETTER_AUTH_SECRET=change-me-to-a-random-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Optional Docker Compose PostgreSQL overrides.
# Keep DATABASE_URL in sync if these are changed.
# POSTGRES_PORT=15432
# POSTGRES_DB=app_template
# POSTGRES_USER=app_template
# POSTGRES_PASSWORD=app_template

# Optional local seed users.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=password1234
# SEED_ADMIN_NAME=Admin User
# SEED_MEMBER_EMAIL=member@example.com
# SEED_MEMBER_PASSWORD=password1234
# SEED_MEMBER_NAME=Member User

# Optional placeholders for future external IdP integrations.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
